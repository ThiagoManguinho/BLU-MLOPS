# Caminho para os pesos do modelo (relativo à raiz do repositório).
BLU_MODEL_PATH=best.pt

# Confiança mínima para aceitar uma detecção. Abaixo disso, a vaga entra em
# "vagas_descartadas_baixa_confianca" em vez de ser classificada.
BLU_CONF_THRESHOLD=0.25

# Porta em que o serviço BentoML escuta.
BLU_SERVICE_PORT=3000
