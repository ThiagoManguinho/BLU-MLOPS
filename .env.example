# Caminho para os pesos do modelo (relativo à raiz do repositório).
BLU_MODEL_PATH=best.pt

# Confiança mínima para aceitar uma detecção. Abaixo disso, a vaga entra em
# "vagas_descartadas_baixa_confianca" em vez de ser classificada.
BLU_CONF_THRESHOLD=0.25

# Porta em que o serviço BentoML escuta.
BLU_SERVICE_PORT=3000

# Log de monitoramento: uma linha JSON por pedido, append-only. Ao passar de
# BLU_LOG_MAX_BYTES, o arquivo vira .1 (até BLU_LOG_BACKUPS antigos guardados).
BLU_LOG_PATH=logs/inferencias.jsonl
BLU_LOG_MAX_BYTES=10485760
BLU_LOG_BACKUPS=5

# Limites de "imagem suspeita" (tirados do conjunto de referência, ver
# referencia/resumo.json) e quantidade de vagas da maquete.
BLU_LIMITE_NITIDEZ_MIN=15
BLU_LIMITE_LUMINANCIA_MIN=100
BLU_LIMITE_ESTOURADA_MAX=0.01
BLU_VAGAS_ESPERADAS=7
