{
  "uid": "blu-estatisticas",
  "title": "BLU - Estatísticas (AV2)",
  "description": "Monitoramento contínuo do drift (KS da nitidez, PSI de vagas ocupadas) e percentis exatos do tempo de resposta, calculados pelo exportador de drift sobre os últimos 100 pedidos do log.",
  "tags": [
    "blu",
    "mlops",
    "drift",
    "av2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "BLU - Monitoramento",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/blu-monitoramento",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumo da janela: últimos 100 pedidos bem-sucedidos × conjunto de referência",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pedidos na janela",
      "description": "Quantos pedidos bem-sucedidos (status 200) entram na comparação. A janela guarda os últimos 100; o KS, o PSI e os percentis só são calculados a partir de 30.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "blu_drift_janela_amostras",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "blue",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 exato",
      "description": "95% dos últimos 100 pedidos ao /prever_ocupacao foram respondidos em até este tempo, medido no servidor. Percentil exato, calculado pedido a pedido pelo exportador de drift. Verde abaixo do SLA de exemplo (400 ms).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "blu_janela_latencia_ms{endpoint=\"/prever_ocupacao\",estatistica=\"p95\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 400
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "KS da nitidez (D)",
      "description": "Distância de Kolmogorov-Smirnov entre a nitidez da janela e a da referência: a maior diferença entre as duas curvas acumuladas (0 = iguais, 1 = sem sobreposição).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "blu_drift_ks_nitidez",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Entrada (nitidez)",
      "description": "Drift quando o D passa do D crítico do KS para alfa = 0,05 (equivale a p-valor < 0,05).",
