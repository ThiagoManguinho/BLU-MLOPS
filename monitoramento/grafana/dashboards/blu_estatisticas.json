    {
      "id": 13,
      "type": "timeseries",
      "title": "KS da nitidez × D crítico",
      "description": "Quando a linha do D (azul) passa da linha do D crítico (vermelha tracejada), a nitidez das imagens recentes é diferente da referência com 95% de confiança. O D crítico depende do tamanho das amostras: 1,358 × √((n+m)/(n·m)).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "blu_drift_ks_nitidez",
          "legendFormat": "D (janela × referência)",
          "refId": "A"
        },
        {
