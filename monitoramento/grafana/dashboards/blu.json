    {
      "id": 13,
      "type": "timeseries",
      "title": "Imagens com problema de qualidade (% nos últimos 5 min)",
      "description": "Fração das imagens dos últimos 5 minutos fora da faixa das fotos de treino, por motivo. É o que as regras de alerta avaliam: acima da linha vermelha (30%) por 1 minuto, sai o e-mail de problema na câmera.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "sum by (motivo) (increase(blu_imagens_suspeitas_total{motivo=~\"borrada|escura|estourada\"}[5m])) / on() group_left sum(increase(blu_imagem_nitidez_count[5m]))",
          "legendFormat": "{{motivo}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "borrada"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "escura"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "estourada"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Imagens suspeitas por minuto (empilhado por motivo)",
      "description": "Quantas imagens suspeitas chegaram em cada minuto. As barras são empilhadas: a altura total é o total do minuto e cada cor é a parte de um motivo, sem um cobrir o outro. vagas_divergentes (o modelo não achou as 7 vagas) é frequente com as fotos de exemplo, que são de perto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "sum by (motivo) (increase(blu_imagens_suspeitas_total[$__interval]))",
          "legendFormat": "{{motivo}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "borrada"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "escura"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "estourada"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
