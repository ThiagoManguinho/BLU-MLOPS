          "expr": "sum by (endpoint, http_response_code) (rate(bentoml_service_request_total{endpoint=~\"/prever_ocupacao.*\"}[1m]))",
          "legendFormat": "{{endpoint}} {{http_response_code}}",
          "refId": "A"
