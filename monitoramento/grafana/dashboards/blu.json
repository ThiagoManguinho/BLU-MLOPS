      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1m"
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Vagas detectadas por imagem (média, 5 min)",
      "description": "A maquete tem 7 vagas (linha tracejada). Média abaixo de 7 por muito tempo indica câmera deslocada, vaga encoberta ou o modelo deixando de detectar vagas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-blu"
          },
          "expr": "sum(rate(blu_vagas_detectadas_sum[5m])) / sum(rate(blu_vagas_detectadas_count[5m]))",
          "legendFormat": "média de vagas detectadas",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "text",
                "value": 7
              }
            ]
          },
          "custom": {
