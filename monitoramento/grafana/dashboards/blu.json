    {
      "id": 9,
      "type": "heatmap",
      "title": "Histograma da latência ao longo do tempo",
      "description": "Cada coluna é um minuto; a cor é a quantidade de pedidos em cada faixa de latência.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-blu"
