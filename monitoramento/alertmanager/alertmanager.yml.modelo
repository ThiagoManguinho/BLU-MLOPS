# Modelo da configuração do Alertmanager. O iniciar.sh troca cada ${VARIAVEL}
# pelo valor da variável de ambiente (padrões no iniciar.sh, valores reais no
# .env.alertas) e grava o resultado em /tmp/alertmanager.yml.
#
# O Alertmanager recebe os alertas do Prometheus (monitoramento/alertas.yml),
# agrupa os do mesmo tipo, evita repetir o aviso e manda o e-mail.

global:
  smtp_smarthost: '${SMTP_SERVIDOR}'
  smtp_from: '${SMTP_REMETENTE}'
  smtp_auth_username: '${SMTP_USUARIO}'
  smtp_auth_password: '${SMTP_SENHA}'
  smtp_require_tls: ${SMTP_TLS}

templates:
  - /etc/alertmanager/email.tmpl

route:
  receiver: email-equipe
  group_by: [alertname]
  # Espera 30 s antes do 1º e-mail de um grupo (junta alertas que chegam juntos),
  # 5 min entre atualizações do mesmo grupo e reenvia a cada 4 h se continuar.
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: email-equipe
    email_configs:
      - to: '${ALERTA_EMAIL_PARA}'
        send_resolved: true
        headers:
          Subject: '{{ template "blu.assunto" . }}'
        html: '{{ template "blu.email.html" . }}'
